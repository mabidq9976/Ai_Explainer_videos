# --- Voice (Gemini TTS) ---
GEMINI_API_KEY=
# Pin the model so a default change never alters your voice mid-test
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Your replicated voice (voice_...) or a prebuilt voice name such as Kore while you wait
GEMINI_VOICE_ID=Kore
# magnific | gemini | elevenlabs | local  (magnific = Claude makes it via the Magnific MCP; local = macOS `say`, free)
TTS_PROVIDER=magnific
# Production voice: Gemini 3.1 Flash TTS with Google voice Puck (714, upbeat). Alternatives: 702 Charon (clear),
# or ElevenLabs v3 with 1213 Fletcher / the owner's cloned voice (MAGNIFIC_VOICE_SOURCE=mine).
MAGNIFIC_VOICE_ID=714
# catalog (shared voices) or mine (your cloned voice in Magnific "My Voices")
MAGNIFIC_VOICE_SOURCE=catalog
# Delivery: energy natural | upbeat | high · stability 0.3 (lively) – 0.7 (steady) · speed 0.7–1.2 (ElevenLabs only)
# Gemini on Magnific: MAGNIFIC_TTS_MODEL=gemini_v3_1_flash_tts with a Google voice (714 = Puck, upbeat; 702 = Charon, clear)
# — Gemini cannot use an ElevenLabs cloned voice.
MAGNIFIC_VOICE_ENERGY=upbeat
MAGNIFIC_VOICE_STABILITY=0.35
MAGNIFIC_VOICE_SPEED=1.05
MAGNIFIC_TTS_MODEL=gemini_v3_1_flash_tts
# Trim dead air and shorten long pauses in every voice take (on | off)
VOICE_TIGHTEN=on

# --- Optional fallback voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock footage ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Magnific: optional — used through the Magnific MCP in Claude, no key needed
MAGNIFIC_API_KEY=
MAGNIFIC_API_BASE=https://api.freepik.com

# --- Local tools (filled by `npm run setup:tools`; override if installed elsewhere) ---
RHUBARB_PATH=
WHISPER_PATH=
WHISPER_MODEL=tools/whisper/ggml-base.en.bin
